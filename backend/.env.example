# Postgres connection used by the app and by `prisma migrate`
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/playcircle"
# Separate database used only by `npm test`. It is wiped on every run.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/playcircle_test"

PORT=3000
# At least 32 random characters in production
JWT_ACCESS_SECRET="change-me-to-a-long-random-string-32chars+"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Coins credited when an account is created
SIGNUP_BONUS_COINS=1000
# Minimum age to register
MIN_AGE_YEARS=18

# Share of the pot the platform keeps when a match has a winner (0-50). Draws refund stakes in full.
HOUSE_FEE_PERCENT=10
# Milliseconds a player has for one move before they forfeit
TURN_TIMEOUT_MS=30000

# Coins from outside the games
DAILY_BONUS_COINS=50          # first day; +10 per streak day up to day 7
AD_REWARD_COINS=25            # per rewarded ad
AD_DAILY_CAP=10               # rewarded ads that pay per day
DAY_OFFSET_MINUTES=60         # day resets at local midnight (60 = Nigeria)
STORE_MODE=live               # 'fake' accepts test receipts and unsigned ad callbacks. Never in production.
# Google Play (consumable coin packs)
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=   # the whole service account JSON on one line
# App Store (In-App Purchase key from App Store Connect)
APPLE_BUNDLE_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=            # the .p8 contents, with newlines written as \n
APPLE_SANDBOX=false

# Addresses allowed to call the API from a browser (the admin website), comma separated
CORS_ORIGINS=http://localhost:5173

# Hosted database (Supabase): set to no-verify so the encrypted connection is accepted.
# DATABASE_SSL=no-verify
# DATABASE_POOL_MAX=10

# Optional: an admin account kept in step with these two values on every start (min 10 characters)
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=
# ADMIN_USERNAME=admin
