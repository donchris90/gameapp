# Postgres connection used by the app and by `prisma migrate`
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/playcircle"
# Separate database used only by `npm test`. It is wiped on every run.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/playcircle_test"

PORT=3000
# At least 32 random characters in production
JWT_ACCESS_SECRET="change-me-to-a-long-random-string-32chars+"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Coins credited when an account is created
SIGNUP_BONUS_COINS=1000
# Minimum age to register
MIN_AGE_YEARS=18

# Share of the pot the platform keeps when a match has a winner (0-50). Draws refund stakes in full.
HOUSE_FEE_PERCENT=10
# Milliseconds a player has for one move before they forfeit
TURN_TIMEOUT_MS=30000
