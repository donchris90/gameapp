// PlayCircle: friends-first multiplayer games, coins only. No real-money
// payouts exist anywhere in this schema by design: coins can be bought
// (store IAP) and earned (ads, bonuses, winning matches) but never withdrawn.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  // Closed by the player. Personal details are erased; the coin ledger stays for the books.
  DELETED
}

// Every coin movement has exactly one of these types. The wallet balance is
// always the sum of that wallet's ledger amounts.
enum GameType {
  TICTACTOE
  WATER_SORT
  AYO
  LUDO
  APEX
  WHOT
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum RoomStatus {
  WAITING
  IN_PROGRESS
}

// PRIVATE: created by a player, joined with a code or an invite.
// QUICK: formed by matchmaking.
enum RoomKind {
  PRIVATE
  QUICK
}

enum MatchStatus {
  ACTIVE
  FINISHED
}

// Why a match ended. TIMEOUT: the player to move ran out of time.
// FORFEIT: a player resigned or left the room mid-game.
enum MatchEndReason {
  NORMAL
  DRAW
  FORFEIT
  TIMEOUT
}

enum PlayerResult {
  WON
  LOST
  DRAW
}

enum LedgerEntryType {
  SIGNUP_BONUS
  DAILY_BONUS
  AD_REWARD
  COIN_PURCHASE
  GAME_STAKE
  GAME_PAYOUT
  GAME_REFUND
  HOUSE_FEE
  SHOP_PURCHASE
  ADJUSTMENT
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  username        String
  usernameLower   String     @unique
  // Shareable code for adding a friend without typing their username
  friendCode      String     @unique
  displayName     String
  passwordHash    String
  birthDate       DateTime   @db.Date
  ageConfirmedAt  DateTime
  termsAcceptedAt DateTime
  role            UserRole   @default(USER)
  // Computer-controlled opponent used to fill free games. Never shown in search, never logs in.
  isBot           Boolean    @default(false)
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  wallet        Wallet?
  refreshTokens RefreshToken[]

  friendshipsA     Friendship[]  @relation("FriendshipA")
  friendshipsB     Friendship[]  @relation("FriendshipB")
  blocksMade       Block[]       @relation("Blocker")
  blocksReceived   Block[]       @relation("Blocked")
  hostedRooms      Room[]        @relation("RoomHost")
  roomMembership   RoomMember?
  invitesSent      RoomInvite[]  @relation("InviteFrom")
  invitesReceived  RoomInvite[]  @relation("InviteTo")
  matchPlayers     MatchPlayer[]
  purchases        Purchase[]
  dailyClaims      DailyClaim[]
  adViews          AdView[]
  auditsMade       AuditLog[]   @relation("AuditAdmin")
  auditsAbout      AuditLog[]   @relation("AuditTarget")
  items            UserItem[]
  messagesSent     Message[]    @relation("MsgSender")
  messagesReceived Message[]    @relation("MsgRecipient")
  pushTokens       PushToken[]
  reportsMade      ChatReport[] @relation("ReportBy")
  reportsAgainst   ChatReport[] @relation("ReportAbout")
  // Cosmetics currently shown. Frame and title are visible to other players; the board theme only to you.
  equippedFrame    String?
  equippedTitle    String?
  equippedTheme    String?
}

// One coin balance per user. Balance only ever changes through
// WalletService, and the database refuses to let it go negative.
model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   BigInt   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger LedgerEntry[]
}

model LedgerEntry {
  id             String          @id @default(uuid())
  // null for platform-level entries (for example the house fee on a pot)
  walletId       String?
  type           LedgerEntryType
  amount         BigInt
  balanceAfter   BigInt?
  reference      String?
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now())

  wallet Wallet? @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([type])
}

// Opaque refresh tokens: only a SHA-256 hash is stored. Rotated on every use;
// presenting an already-used token revokes the whole family.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

// A friendship is one row per pair. userAId < userBId (string order) so the
// pair is unique regardless of who asked first.
model Friendship {
  id            String           @id @default(uuid())
  userAId       String
  userBId       String
  requestedById String
  status        FriendshipStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  respondedAt   DateTime?

  userA User @relation("FriendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// A lobby. Stays open between games so friends can rematch; deleted when the
// last player leaves.
model Room {
  id         String     @id @default(uuid())
  code       String     @unique
  game       GameType
  kind       RoomKind   @default(PRIVATE)
  hostId     String
  stake      BigInt     @default(0)
  minPlayers Int
  maxPlayers Int
  status     RoomStatus @default(WAITING)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  startedAt  DateTime?

  host    User         @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  members RoomMember[]
  invites RoomInvite[]
}

// userId is unique: a player is in at most one room at a time.
model RoomMember {
  id       String   @id @default(uuid())
  roomId   String
  userId   String   @unique
  seat     Int
  ready    Boolean  @default(false)
  joinedAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, seat])
}

model RoomInvite {
  id         String   @id @default(uuid())
  roomId     String
  fromUserId String
  toUserId   String
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  from User @relation("InviteFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to   User @relation("InviteTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([roomId, toUserId])
  @@index([toUserId])
}

// One played game. Stakes are debited when it is created and settled when it
// ends, both inside database transactions, so coins can never be half-moved.
// roomId has no foreign key: the lobby may be deleted while history stays.
model Match {
  id           String          @id @default(uuid())
  roomId       String?
  game         GameType
  stake        BigInt          @default(0)
  pot          BigInt          @default(0)
  houseFee     BigInt          @default(0)
  status       MatchStatus     @default(ACTIVE)
  endReason    MatchEndReason?
  winnerId     String?
  state        Json
  // Bumped on every change. Clients send the version they saw with a move,
  // so a double tap or stale screen cannot play the same turn twice.
  version      Int             @default(1)
  turnSeat     Int?
  turnDeadline DateTime?
  startedAt    DateTime        @default(now())
  finishedAt   DateTime?

  players MatchPlayer[]

  @@index([status, turnDeadline])
  @@index([roomId])
}

model MatchPlayer {
  id      String        @id @default(uuid())
  matchId String
  userId  String
  seat    Int
  stake   BigInt        @default(0)
  // Coins returned to this player at the end (winnings, or the refund on a draw)
  payout  BigInt        @default(0)
  result  PlayerResult?
  leftAt  DateTime?

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@unique([matchId, seat])
  @@index([userId])
}

enum StorePlatform {
  GOOGLE
  APPLE
}

enum AdViewStatus {
  PENDING
  REWARDED
  EXPIRED
}

// A coin pack bought through Google Play or the App Store. The store's own transaction id is
// unique per platform, so a receipt can never be turned into coins twice.
model Purchase {
  id            String        @id @default(uuid())
  userId        String
  platform      StorePlatform
  productId     String
  transactionId String
  coins         BigInt
  createdAt     DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([platform, transactionId])
  @@index([userId])
}

// One row per user per day they took the daily bonus. `day` is the local date (see DAY_OFFSET_MINUTES).
model DailyClaim {
  id        String   @id @default(uuid())
  userId    String
  day       String
  streak    Int
  coins     BigInt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

// A rewarded ad the player is about to watch. The ad network's server-to-server callback
// carries `nonce`, and that callback (never the app) is what pays the coins.
model AdView {
  id            String       @id @default(uuid())
  userId        String
  nonce         String       @unique
  day           String
  status        AdViewStatus @default(PENDING)
  transactionId String?      @unique
  coins         BigInt       @default(0)
  createdAt     DateTime     @default(now())
  rewardedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, day])
}

// Everything an admin does to a player is written here, and cannot be edited from the app.
model AuditLog {
  id           String   @id @default(uuid())
  adminId      String
  action       String
  targetUserId String?
  data         Json?
  createdAt    DateTime @default(now())

  admin  User  @relation("AuditAdmin", fields: [adminId], references: [id])
  target User? @relation("AuditTarget", fields: [targetUserId], references: [id])

  @@index([createdAt])
  @@index([targetUserId])
}

// A cosmetic a player owns. One row per player per item, so an item can only be bought once.
model UserItem {
  id         String   @id @default(uuid())
  userId     String
  itemId     String
  pricePaid  BigInt
  acquiredAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

// A private message between two friends. Deleted after the retention period (30 days by default).
model Message {
  id          String    @id @default(uuid())
  senderId    String
  recipientId String
  body        String
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  sender    User @relation("MsgSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("MsgRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
  @@index([senderId, recipientId, createdAt])
  @@index([createdAt])
}

// Expo push token of one of a player's phones.
model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ReportStatus {
  OPEN
  RESOLVED
}

// A player reporting a message they received. The text and the lines around it are copied here, so the
// report still makes sense after the chat is cleaned up.
model ChatReport {
  id           String       @id @default(uuid())
  reporterId   String
  reportedId   String
  messageId    String?
  messageText  String
  context      Json
  reason       String
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  reporter User @relation("ReportBy", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("ReportAbout", fields: [reportedId], references: [id], onDelete: Cascade)

  @@unique([reporterId, messageId])
  @@index([status, createdAt])
}

// Admin-editable settings, one row per setting (value is JSON). See SettingsService.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
